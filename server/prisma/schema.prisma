generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  password      String? // null이면 소셜 전용 가입자
  nickname      String
  profileImage  String?
  birthDate     DateTime?
  zodiacSign    String? // 별자리
  chineseZodiac String? // 띠
  fcmToken      String?
  notiPrefs     Json? // 알림 설정 (sound, vibrate, 카테고리별 등)
  coupleId      String?
  couple        Couple?   @relation(fields: [coupleId], references: [id])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sentMessages    Message[]        @relation("sender")
  calendarEvents  CalendarEvent[]  @relation("eventAuthor")
  feeds           Feed[]           @relation("feedAuthor")
  moods           Mood[]
  fights          Fight[]          @relation("fightAuthor")
  photos          Photo[]          @relation("photoAuthor")
  lettersWritten  Letter[]         @relation("letterWriter")
  lettersReceived Letter[]         @relation("letterReceiver")
  feedLikes       FeedLike[]
  feedComments    FeedComment[]    @relation("commentAuthor")
  inquiries       Inquiry[]
  notifications   Notification[]
  wishItems       WishItem[]       @relation("wishAuthor")
  questionAnswers QuestionAnswer[]
  socialAccounts  SocialAccount[]
  doodlesSent     Doodle[]         @relation("doodleSender")
  doodlesReceived Doodle[]         @relation("doodleReceiver")
  pokesSent       Poke[]           @relation("pokeSender")
  pokesReceived   Poke[]           @relation("pokeReceiver")
  diaryEntries    DiaryEntry[]

  @@index([coupleId])
}

enum SocialProvider {
  GOOGLE
  APPLE
  KAKAO
}

model SocialAccount {
  id         String         @id @default(uuid())
  userId     String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider   SocialProvider
  providerId String // 각 provider의 고유 식별자 (sub, id 등)
  email      String? // provider가 제공한 이메일 (있는 경우)
  createdAt  DateTime       @default(now())

  @@unique([provider, providerId])
  @@unique([userId, provider])
  @@index([userId])
}

model Couple {
  id         String   @id @default(uuid())
  inviteCode String   @unique
  startDate  DateTime
  // 상대가 앱을 설치하기 전에 먼저 시작한 커플(멤버 1명). 상대가 초대 코드로 합류하면 false.
  isSolo     Boolean  @default(false)
  // 상대가 합류하기 전에 미리 적어둔 상대 이름/애칭. 합류하면 실제 닉네임이 우선한다.
  pendingPartnerName String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  users          User[]
  calendarEvents CalendarEvent[]
  feeds          Feed[]
  moods          Mood[]
  fights         Fight[]
  fortunes       Fortune[]
  messages       Message[]
  photos         Photo[]
  letters        Letter[]
  missions       CoupleMission[]
  wishItems      WishItem[]
  dailyQuestions DailyQuestion[]
  doodles        Doodle[]
  pokes          Poke[]
  diaryEntries   DiaryEntry[]
}

enum MissionType {
  DAILY
  WEEKLY
}

model CoupleMission {
  id          String      @id @default(uuid())
  coupleId    String
  couple      Couple      @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  type        MissionType
  title       String
  description String
  emoji       String      @default("💝")
  date        DateTime    @db.Date // DAILY: that date, WEEKLY: Monday of the week
  isCompleted Boolean     @default(false)
  completedBy String? // userId who marked it
  completedAt DateTime?
  createdAt   DateTime    @default(now())

  @@unique([coupleId, type, date])
  @@index([coupleId, date])
}

model CalendarEvent {
  id            String     @id @default(uuid())
  coupleId      String
  couple        Couple     @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  authorId      String
  author        User       @relation("eventAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  title         String
  description   String?
  date          DateTime
  isAnniversary Boolean    @default(false)
  repeatType    RepeatType @default(NONE)
  color         String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([coupleId, date])
}

enum RepeatType {
  NONE
  YEARLY
  MONTHLY
}

model Feed {
  id        String   @id @default(uuid())
  coupleId  String
  couple    Couple   @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation("feedAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  content   String
  imageUrls String[] @default([])
  type      FeedType @default(DIARY)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  likes    FeedLike[]
  comments FeedComment[]

  @@index([coupleId, createdAt])
}

model FeedLike {
  id        String   @id @default(uuid())
  feedId    String
  feed      Feed     @relation(fields: [feedId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([feedId, userId])
}

model FeedComment {
  id        String   @id @default(uuid())
  feedId    String
  feed      Feed     @relation(fields: [feedId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation("commentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime @default(now())

  @@index([feedId])
}

enum FeedType {
  DIARY
  PHOTO
  MILESTONE
}

model Mood {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  coupleId  String
  couple    Couple   @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  emoji     String
  message   String?
  date      DateTime @db.Date
  createdAt DateTime @default(now())

  @@unique([userId, date])
  @@index([coupleId, date])
}

model Fight {
  id         String   @id @default(uuid())
  coupleId   String
  couple     Couple   @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  authorId   String
  author     User     @relation("fightAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  date       DateTime
  reason     String
  resolution String?
  reflection String?
  isResolved Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([coupleId])
}

model Fortune {
  id          String   @id @default(uuid())
  coupleId    String
  couple      Couple   @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  date        DateTime @db.Date
  generalLuck String
  coupleLuck  String
  dateTip     String
  caution     String
  luckyScore  Int
  user1Id     String?
  user1Luck   String?
  user2Id     String?
  user2Luck   String?
  createdAt   DateTime @default(now())

  @@unique([coupleId, date])
}

model Message {
  id        String   @id @default(uuid())
  coupleId  String
  couple    Couple   @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User     @relation("sender", fields: [senderId], references: [id], onDelete: Cascade)
  content   String?
  imageUrls String[] @default([])
  isRead    Boolean  @default(false)
  isEdited  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([coupleId, createdAt])
  @@index([coupleId, isRead])
}

model Photo {
  id           String    @id @default(uuid())
  coupleId     String
  couple       Couple    @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  authorId     String
  author       User      @relation("photoAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  imageUrl     String
  thumbnailUrl String?
  caption      String?
  latitude     Float?
  longitude    Float?
  address      String?
  takenAt      DateTime?
  createdAt    DateTime  @default(now())

  @@index([coupleId])
}

model Doodle {
  id         String   @id @default(uuid())
  coupleId   String
  couple     Couple   @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  senderId   String
  sender     User     @relation("doodleSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId String
  receiver   User     @relation("doodleReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  imageUrl   String
  createdAt  DateTime @default(now())

  @@index([coupleId, createdAt])
  @@index([receiverId, createdAt])
}

/// "보고싶어" 콕 — 상대에게 보내는 한 번의 가벼운 마음 표현 (푸시 + 위젯/홈 표시용 기록)
model Poke {
  id         String   @id @default(uuid())
  coupleId   String
  couple     Couple   @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  senderId   String
  sender     User     @relation("pokeSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId String
  receiver   User     @relation("pokeReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  kind       String   // miss, love, cheer, thanks, sorry, goodnight
  createdAt  DateTime @default(now())

  @@index([receiverId, createdAt])
  @@index([coupleId, createdAt])
}

model Letter {
  id           String       @id @default(uuid())
  coupleId     String
  couple       Couple       @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  writerId     String
  writer       User         @relation("letterWriter", fields: [writerId], references: [id], onDelete: Cascade)
  receiverId   String
  receiver     User         @relation("letterReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  title        String
  content      String
  deliveryDate DateTime
  status       LetterStatus @default(DRAFT)
  isRead       Boolean      @default(false)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([coupleId])
  @@index([status, deliveryDate])
}

enum LetterStatus {
  DRAFT
  SCHEDULED
  DELIVERED
}

model Inquiry {
  id          String        @id @default(uuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  category    String // bug, feature, account, other
  title       String
  content     String
  // 디바이스 정보
  appVersion  String?
  deviceModel String?
  osVersion   String?
  // 관리자 처리
  status      InquiryStatus @default(PENDING)
  adminReply  String?
  repliedAt   DateTime?
  isReplyRead Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

enum InquiryStatus {
  PENDING
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model AdminAccount {
  id        String   @id @default(uuid())
  username  String   @unique
  password  String
  createdAt DateTime @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // feed, feed_like, feed_comment, letter, calendar, mood, fight, fortune, inquiry, couple_left
  title     String
  body      String
  data      Json? // { feedId, letterId, etc. }
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@index([userId, createdAt])
}

model AppSettings {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

enum WishCategory {
  PLACE
  FOOD
  ACTIVITY
  OTHER
}

model WishItem {
  id          String       @id @default(uuid())
  coupleId    String
  couple      Couple       @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  authorId    String
  author      User         @relation("wishAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  category    WishCategory @default(OTHER)
  title       String
  memo        String?
  isFavorite  Boolean      @default(false)
  isCompleted Boolean      @default(false)
  completedBy String?
  completedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([coupleId, category])
  @@index([coupleId, isFavorite, isCompleted])
}

model DailyQuestion {
  id          String           @id @default(uuid())
  coupleId    String
  couple      Couple           @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  questionIdx Int
  date        DateTime         @db.Date
  answers     QuestionAnswer[]
  createdAt   DateTime         @default(now())

  @@unique([coupleId, date])
  @@index([coupleId])
}

model QuestionAnswer {
  id         String        @id @default(uuid())
  questionId String
  question   DailyQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  userId     String
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  answer     String
  createdAt  DateTime      @default(now())

  @@unique([questionId, userId])
}

// 일기. SHARED = 교환일기(둘 다 언제든 쓰고 바로 함께 봄), PRIVATE = 개인일기(나만 보고,
// revealAt 이 지나면 상대에게도 공개. null 이면 계속 비공개).
model DiaryEntry {
  id        String    @id @default(uuid())
  coupleId  String
  couple    Couple    @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  authorId  String
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  kind      String    @default("SHARED")
  entryDate DateTime  @default(now())
  mood      String?
  content   String
  revealAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([coupleId, kind, entryDate])
  @@index([authorId, kind])
}
