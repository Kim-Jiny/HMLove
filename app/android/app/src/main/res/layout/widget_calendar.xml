<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<LinearLayout
    android:id="@+id/widget_card"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginStart="6dp"
    android:layout_marginTop="8dp"
    android:layout_marginEnd="6dp"
    android:layout_marginBottom="4dp"
    android:background="@drawable/widget_paper_front"
    android:orientation="vertical"
    android:paddingStart="10dp"
    android:paddingTop="14dp"
    android:paddingEnd="10dp"
    android:paddingBottom="12dp">

    <!-- Top bar: couple name + D-Day -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/cal_couple_names"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#EC5F8E"
            android:textSize="11sp"
            android:textStyle="bold"
            android:singleLine="true" />

        <TextView
            android:id="@+id/cal_dday_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#EC5F8E"
            android:textSize="11sp"
            android:textStyle="bold"
            android:singleLine="true" />

        <TextView
            android:id="@+id/cal_settings_btn"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="6dp"
            android:gravity="center"
            android:text="⚙"
            android:textColor="#7A7480"
            android:textSize="14sp"
            android:background="@drawable/widget_calendar_nav_btn_bg" />
    </LinearLayout>

    <!-- Month header: prev / title / today / next -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/cal_prev_month"
            android:layout_width="30dp"
            android:layout_height="24dp"
            android:gravity="center"
            android:text="◀"
            android:textColor="#EC5F8E"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="@drawable/widget_calendar_nav_btn_bg" />

        <TextView
            android:id="@+id/cal_month_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:fontFamily="sans-serif-black"
            android:textColor="#2E2A33"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/cal_today_month"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:gravity="center"
            android:text="오늘"
            android:textColor="#EC5F8E"
            android:textSize="10sp"
            android:textStyle="bold"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:background="@drawable/widget_calendar_nav_btn_bg" />

        <TextView
            android:id="@+id/cal_next_month"
            android:layout_width="30dp"
            android:layout_height="24dp"
            android:gravity="center"
            android:text="▶"
            android:textColor="#EC5F8E"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginStart="4dp"
            android:background="@drawable/widget_calendar_nav_btn_bg" />
    </LinearLayout>

    <!-- Weekday headers -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingBottom="2dp">

        <TextView
            android:id="@+id/cal_weekday_sun"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="일"
            android:textColor="#EC5F8E"
            android:textSize="10sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/cal_weekday_mon"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="월"
            android:textColor="#7A7480"
            android:textSize="10sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/cal_weekday_tue"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="화"
            android:textColor="#7A7480"
            android:textSize="10sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/cal_weekday_wed"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="수"
            android:textColor="#7A7480"
            android:textSize="10sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/cal_weekday_thu"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="목"
            android:textColor="#7A7480"
            android:textSize="10sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/cal_weekday_fri"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="금"
            android:textColor="#7A7480"
            android:textSize="10sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/cal_weekday_sat"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="토"
            android:textColor="#7A7480"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Calendar grid: 6 rows x 7 columns = 42 cells -->
    <!-- Each cell is a vertical LinearLayout with day number + dot indicator -->
    <LinearLayout
        android:id="@+id/cal_grid_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Row 0 -->
        <LinearLayout
            android:id="@+id/cal_row_0"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal" />

        <!-- Row 1 -->
        <LinearLayout
            android:id="@+id/cal_row_1"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal" />

        <!-- Row 2 -->
        <LinearLayout
            android:id="@+id/cal_row_2"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal" />

        <!-- Row 3 -->
        <LinearLayout
            android:id="@+id/cal_row_3"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal" />

        <!-- Row 4 -->
        <LinearLayout
            android:id="@+id/cal_row_4"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal" />

        <!-- Row 5 -->
        <LinearLayout
            android:id="@+id/cal_row_5"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal" />
    </LinearLayout>

</LinearLayout>

<ImageView
    android:id="@+id/paper_tape"
    android:layout_width="74dp"
    android:layout_height="20dp"
    android:layout_gravity="top|center_horizontal"
    android:contentDescription="@null"
    android:rotation="-3"
    android:src="@drawable/widget_tape" />

</FrameLayout>
