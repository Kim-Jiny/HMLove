<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:id="@+id/paper_back_pink"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="4dp"
        android:background="@drawable/widget_paper_back_pink"
        android:rotation="-2" />

    <FrameLayout
        android:id="@+id/paper_back_lavender"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="4dp"
        android:background="@drawable/widget_paper_back_lavender"
        android:rotation="1.7" />

    <FrameLayout
        android:id="@+id/widget_card"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="4dp"
        android:background="@drawable/widget_paper_front"
        android:paddingStart="10dp"
        android:paddingTop="12dp"
        android:paddingEnd="10dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/couple_names"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="나 ♥ 상대방"
                android:textColor="#4A3B52"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/days_together"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:fontFamily="sans-serif-black"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:text="365일"
                android:textColor="#EC5F8E"
                android:textSize="32sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/start_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:singleLine="true"
                android:text="2025.02.26 ~"
                android:textColor="#7A7480"
                android:textSize="10sp" />

            <ImageView
                android:id="@+id/anniv_progress"
                android:layout_width="match_parent"
                android:layout_height="22dp"
                android:layout_marginTop="4dp"
                android:contentDescription="@null"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/next_anniversary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="500일까지 D-135"
                android:textColor="#4A3B52"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_settings_btn"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="top|end"
            android:background="@drawable/widget_calendar_nav_btn_bg"
            android:gravity="center"
            android:text="⚙"
            android:textColor="#EC5F8E"
            android:textSize="13sp" />
    </FrameLayout>

    <ImageView
        android:id="@+id/paper_tape"
        android:layout_width="74dp"
        android:layout_height="20dp"
        android:layout_gravity="top|center_horizontal"
        android:contentDescription="@null"
        android:rotation="-3"
        android:src="@drawable/widget_tape" />

</FrameLayout>
