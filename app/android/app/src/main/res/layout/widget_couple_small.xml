<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:paddingStart="12dp"
    android:paddingTop="10dp"
    android:paddingEnd="12dp"
    android:paddingBottom="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/couple_names"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="나 ♥ 상대방"
            android:textColor="#EC5F8E"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/days_together"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="sans-serif-black"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:text="365일"
            android:textColor="#EC5F8E"
            android:textSize="38sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/start_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="2025.02.26 ~"
            android:textColor="#B9B3BE"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/next_anniversary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/widget_pill_bg"
            android:ellipsize="end"
            android:paddingStart="8dp"
            android:paddingTop="2dp"
            android:paddingEnd="8dp"
            android:paddingBottom="2dp"
            android:singleLine="true"
            android:text="500일 D-135"
            android:textColor="#4A3B52"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_settings_btn"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_gravity="top|end"
        android:background="@drawable/widget_calendar_nav_btn_bg"
        android:gravity="center"
        android:text="⚙"
        android:textColor="#EC5F8E"
        android:textSize="14sp" />

</FrameLayout>
