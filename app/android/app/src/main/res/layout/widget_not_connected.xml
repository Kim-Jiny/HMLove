<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:id="@+id/paper_back_pink"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="4dp"
        android:background="@drawable/widget_paper_back_pink"
        android:rotation="-2" />

    <FrameLayout
        android:id="@+id/paper_back_lavender"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="4dp"
        android:background="@drawable/widget_paper_back_lavender"
        android:rotation="1.7" />

    <LinearLayout
        android:id="@+id/widget_card"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="4dp"
        android:background="@drawable/widget_paper_front"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="14dp"
        android:paddingEnd="14dp"
        android:paddingBottom="12dp">

        <ImageView
            android:id="@+id/widget_not_connected_face"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="@null"
            android:src="@drawable/mood_face_love" />

        <TextView
            android:id="@+id/widget_not_connected_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="우리연애"
            android:textColor="#EC5F8E"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_not_connected_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="앱에서 로그인하고\n커플을 연결해보세요"
            android:textColor="#7A7480"
            android:textSize="13sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/paper_tape"
        android:layout_width="74dp"
        android:layout_height="20dp"
        android:layout_gravity="top|center_horizontal"
        android:contentDescription="@null"
        android:rotation="-3"
        android:src="@drawable/widget_tape" />

</FrameLayout>
