<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="16dp">

    <ImageView
        android:id="@+id/widget_not_connected_face"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:contentDescription="@null"
        android:src="@drawable/mood_face_love" />

    <TextView
        android:id="@+id/widget_not_connected_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="우리연애"
        android:textColor="#EC5F8E"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_not_connected_message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:text="앱에서 로그인하고\n커플을 연결해보세요"
        android:textColor="#7A7480"
        android:textSize="13sp" />

</LinearLayout>
