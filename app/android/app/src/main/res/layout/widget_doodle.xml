<?xml version="1.0" encoding="utf-8"?>
<!-- 그림 위젯: 폴라로이드 한 장 + 분홍 테이프 + 뒤에 라벤더 종이 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_doodle_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="8dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="4dp"
        android:background="@drawable/widget_paper_back_lavender"
        android:rotation="2" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="8dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="4dp"
        android:background="@drawable/widget_doodle_paper"
        android:orientation="vertical"
        android:paddingStart="7dp"
        android:paddingTop="9dp"
        android:paddingEnd="7dp"
        android:paddingBottom="12dp">

        <!-- 사진 영역 -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/widget_doodle_frame_bg"
            android:padding="1dp">

            <!-- 그림 이미지 (꽉 채움, 둥근 모서리로 잘림) -->
            <ImageView
                android:id="@+id/widget_doodle_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/widget_doodle_image_bg"
                android:clipToOutline="true"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                android:visibility="gone" />

            <!-- 빈 상태: 그림 없음 -->
            <LinearLayout
                android:id="@+id/widget_doodle_empty"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="4dp">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:contentDescription="@null"
                    android:src="@drawable/mood_face_peaceful" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:text="아직 받은\n그림이 없어요"
                    android:textColor="#2E2A33"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/widget_pill_bg"
                    android:gravity="center"
                    android:paddingStart="8dp"
                    android:paddingTop="1dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="1dp"
                    android:text="앱에서 그림 보내기"
                    android:textColor="#4A3B52"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>

        <!-- 캡션 -->
        <LinearLayout
            android:id="@+id/widget_doodle_caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="3dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/widget_doodle_sender"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="#4A3B52"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_doodle_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:singleLine="true"
                android:textColor="#7A7480"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <ImageView
        android:layout_width="66dp"
        android:layout_height="20dp"
        android:layout_gravity="top|center_horizontal"
        android:contentDescription="@null"
        android:rotation="-3"
        android:src="@drawable/widget_tape_pink" />

</FrameLayout>
