<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:left="2dp"
        android:top="4dp">
        <shape android:shape="rectangle">
            <solid android:color="#F3CCD9" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <item
        android:right="2dp"
        android:bottom="4dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFF8FA" />
            <stroke
                android:width="1.5dp"
                android:color="#4A3B52" />
            <corners android:radius="28dp" />
        </shape>
    </item>
</layer-list>
