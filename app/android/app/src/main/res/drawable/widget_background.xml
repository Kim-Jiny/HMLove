<?xml version="1.0" encoding="utf-8"?>
<!-- 카툰 파스텔 카드: 핑크->라벤더 그라데이션 + 잉크 외곽선 + 하드 오프셋 그림자 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:left="2dp"
        android:top="4dp">
        <shape android:shape="rectangle">
            <solid android:color="#F3CCD9" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item
        android:right="2dp"
        android:bottom="4dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="#FFFFE3EC"
                android:endColor="#FFF0EDFF" />
            <stroke
                android:width="1.5dp"
                android:color="#4A3B52" />
            <corners android:radius="24dp" />
        </shape>
    </item>
</layer-list>
